generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Workspace {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  apiKeys    ApiKey[]
  customers  Customer[]
  events     Event[]
  segments   Segment[]
  campaigns  Campaign[]
  canvases   Canvas[]
  templates         MessageTemplate[]
  contentTemplates  ContentTemplate[]
  contentFiles      ContentFile[]
  planProjects      PlanProject[]
  listExtensions    ListExtension[]
  suppressionLists  SuppressionList[]
}

model ApiKey {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name        String
  key         String    @unique
  lastUsedAt  DateTime?
  createdAt   DateTime  @default(now())
}

model Customer {
  id           String    @id @default(cuid())
  workspaceId  String
  workspace    Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  externalId   String
  email        String?
  phone        String?
  firstName    String?
  lastName     String?
  country      String?
  timezone     String?
  /// JSON object of custom attributes
  attributes   String    @default("{}")
  /// JSON object of subscription groups: { email: true, push: true, sms: false }
  subscriptions String   @default("{\"email\":true,\"push\":true,\"sms\":true,\"in_app\":true}")
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  lastSeenAt   DateTime?

  events   Event[]
  sends    CampaignSend[]
  entries  CanvasEntry[]

  @@unique([workspaceId, externalId])
  @@index([workspaceId, email])
}

model Event {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  customerId  String
  customer    Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  name        String
  /// JSON payload
  properties  String    @default("{}")
  occurredAt  DateTime  @default(now())
  createdAt   DateTime  @default(now())

  @@index([workspaceId, name, occurredAt])
  @@index([customerId, occurredAt])
}

model Segment {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name        String
  description String?
  /// JSON rule tree — see src/lib/segments.ts
  rules       String    @default("{\"op\":\"and\",\"filters\":[]}")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  campaigns Campaign[]
  canvases  Canvas[]
}

model MessageTemplate {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name        String
  channel     String
  subject     String?
  body        String
  /// drag-drop | html
  editorType  String    @default("html")
  createdBy   String    @default("VISORA")
  /// saved | visora
  source      String    @default("saved")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  campaigns Campaign[]
}

model Campaign {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name        String
  description String?
  channel     String
  status      String    @default("draft")
  subject     String?
  /// Sender address shown in the email header
  fromAddress String?
  body        String
  segmentId   String?
  segment     Segment?  @relation(fields: [segmentId], references: [id])
  /// JSON targeting: segments, filter groups, exclusion groups
  targetingRules String @default("{}")
  /// Conversion event to track, e.g. purchase, signup
  conversionEvent String?
  templateId  String?
  template    MessageTemplate? @relation(fields: [templateId], references: [id])
  scheduledAt DateTime?
  sentAt      DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  sends CampaignSend[]
}

model CampaignSend {
  id         String   @id @default(cuid())
  campaignId String
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  status     String   @default("queued")
  channel    String
  subject    String?
  body       String
  sentAt     DateTime?
  openedAt   DateTime?
  clickedAt  DateTime?
  createdAt  DateTime @default(now())

  @@index([campaignId, status])
}

model Canvas {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name        String
  description String?
  status      String    @default("draft")
  segmentId   String?
  segment     Segment?  @relation(fields: [segmentId], references: [id])
  /// JSON array of conversion event names (max 4)
  conversionEvents String @default("[]")
  /// JSON array of tag strings
  tags        String    @default("[]")
  /// JSON entry schedule settings
  entrySchedule String  @default("{}")
  /// JSON send settings
  sendSettings String   @default("{}")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  steps   CanvasStep[]
  entries CanvasEntry[]
}

model CanvasStep {
  id        String @id @default(cuid())
  canvasId  String
  canvas    Canvas @relation(fields: [canvasId], references: [id], onDelete: Cascade)
  order     Int
  type      String
  name      String
  /// JSON config: delay hours, channel, message body, etc.
  config    String @default("{}")

  @@index([canvasId, order])
}

model CanvasEntry {
  id         String   @id @default(cuid())
  canvasId   String
  canvas     Canvas   @relation(fields: [canvasId], references: [id], onDelete: Cascade)
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  stepIndex  Int      @default(0)
  status     String   @default("active")
  enteredAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([canvasId, customerId])
}

model ContentTemplate {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  /// push | in_app | content_card
  kind        String
  name        String
  title       String?
  body        String
  imageUrl    String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([workspaceId, kind])
}

model ContentFile {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  /// image | html
  kind        String
  name        String
  /// Public URL for images; raw HTML for html files
  content     String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([workspaceId, kind])
}

model PlanProject {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name        String
  description String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  tasks PlanTask[]
}

model PlanTask {
  id          String      @id @default(cuid())
  projectId   String
  project     PlanProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title       String
  /// todo | in_progress | done
  status      String      @default("todo")
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@index([projectId, status])
}

model ListExtension {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name        String
  /// email | sms | custom
  type        String
  description String?
  /// JSON array of attribute field keys, e.g. ["first_name","last_name","company"]
  attributes  String    @default("[]")
  status      String    @default("active")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  entries ListExtensionEntry[]
}

model ListExtensionEntry {
  id           String        @id @default(cuid())
  extensionId  String
  extension    ListExtension @relation(fields: [extensionId], references: [id], onDelete: Cascade)
  externalId   String?
  email        String?
  phone        String?
  firstName    String?
  lastName     String?
  /// JSON object of extra attribute values
  attributes   String        @default("{}")
  createdAt    DateTime      @default(now())

  @@index([extensionId])
}

model SuppressionList {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name        String
  /// email | sms | push | all
  channel     String    @default("all")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  entries SuppressionEntry[]
}

model SuppressionEntry {
  id        String          @id @default(cuid())
  listId    String
  list      SuppressionList @relation(fields: [listId], references: [id], onDelete: Cascade)
  email     String?
  phone     String?
  externalId String?
  createdAt DateTime        @default(now())
}
