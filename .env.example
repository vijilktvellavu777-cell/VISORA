DATABASE_URL="file:./dev.db"
NEXT_PUBLIC_APP_NAME="VISORA"

# Login (default local account is created on db:sync if none exists)
# VISORA_LOGIN_USERNAME="admin"
# VISORA_LOGIN_EMAIL="admin@visora.local"
# VISORA_LOGIN_PASSWORD="VisoraAdmin1!"
# VISORA_LOGIN_SYNC_PASSWORD="true"  # force reset default admin password on db:sync (default: true in dev, false in production)
# SESSION_SECRET="change-me-in-production"
# NEXT_PUBLIC_APP_URL="http://localhost:3000"
# RESEND_API_KEY="" # optional — sends real reset emails when set
# VISORA_EMAIL_FROM="VISORA <onboarding@resend.dev>"

# Push notifications (optional — without these, push campaigns run in simulation mode)
# Generate VAPID keys: npx web-push generate-vapid-keys
# VAPID_PUBLIC_KEY=""
# VAPID_PRIVATE_KEY=""
# VAPID_SUBJECT="mailto:you@example.com"
# FCM_SERVER_KEY=""
# APNS_KEY_ID=""
# APNS_TEAM_ID=""
# APNS_KEY=""
# APNS_BUNDLE_ID=""
# PUSH_SIMULATION_MODE="true"

# Optional: enable full AI responses for Bubu
# OPENAI_API_KEY="sk-..."
# OPENAI_MODEL="gpt-4o-mini"
