{
  "name": "visora",
  "version": "0.1.0",
  "private": true,
  "description": "VISORA — a customer engagement platform for campaigns, segments, and event-driven messaging.",
  "scripts": {
    "dev": "next dev",
    "predev": "npm run db:sync",
    "build": "prisma generate && npm run build:sdk && next build",
    "start": "next start",
    "lint": "next lint",
    "postinstall": "prisma generate",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:sync": "prisma db push && npx tsx scripts/ensure-sdk-keys.ts",
    "db:seed": "npx tsx prisma/seed.ts",
    "db:reset": "prisma db push --force-reset && npx tsx prisma/seed.ts",
    "build:sdk": "esbuild packages/visora-sdk/src/index.ts --bundle --format=iife --global-name=Visora --outfile=public/visora.js --target=es2020",
    "test": "npx tsx scripts/test-segments.ts"
  },
  "prisma": {
    "seed": "npx tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.13.0",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "lucide-react": "^0.539.0",
    "next": "^15.4.6",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "zod": "^4.0.17",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.11",
    "@types/node": "^24.2.1",
    "@types/web-push": "^3.6.4",
    "@types/react": "^19.1.9",
    "@types/react-dom": "^19.1.7",
    "eslint": "^9.32.0",
    "eslint-config-next": "^15.4.6",
    "esbuild": "^0.25.9",
    "prisma": "^6.13.0",
    "tailwindcss": "^4.1.11",
    "tsx": "^4.20.3",
    "typescript": "^5.9.2"
  }
}
